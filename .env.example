# Copy this file to .env and fill in what you have.
# Any platform without credentials runs in DRY-RUN mode (content is generated, not posted).

# ── LLM ──────────────────────────────────────────
# anthropic | groq
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Stronger model for designing posts & video storyboards (quality matters most here; ~$0.05-0.15 per piece)
ANTHROPIC_DESIGN_MODEL=claude-sonnet-4-5
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Optional: AI photos (festival backgrounds, meme posts). Without them festival posts use
#    hand-drawn illustrated scenes and other posts are drawn with CSS/SVG.
# none | pollinations | gemini | openai
IMAGE_PROVIDER=none
# pollinations: free key from https://enter.pollinations.ai (sign in with GitHub) → API keys → secret key (sk_…)
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=flux
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Text-to-speech: edge (free, default) | pyttsx3 (offline) | silent
TTS_PROVIDER=edge

# ── Cloud database & file storage (Render; on your PC only if it makes the website's videos – see below) ──
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=media

# ── Public URL of this app (needed for Instagram: it downloads media from a public URL)
# e.g. https://your-app.onrender.com   (no trailing slash)
PUBLIC_BASE_URL=http://localhost:8000

# ── Videos made on this PC for the website (run_video_worker.bat) ──
# To make the live site's videos on this PC: put the SAME DATABASE_URL, SUPABASE_URL and SUPABASE_SERVICE_KEY
# as on Render above, and set VIDEO_RENDERER=pc on Render (not here). Optional name shown on the website:
WORKER_NAME=
# Dashboard login (basic auth)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me

# ── Social accounts: easiest is the dashboard (Settings → Connections). The values below are an optional fallback.
# Optional: app credentials for "Connect with Facebook/LinkedIn" (can also be entered in the dashboard)
# Instagram only (no Facebook Page): usually set in the dashboard (Settings → Connections → Instagram)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_CONFIG_ID=
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Meta (Facebook Page + Instagram Business) ────
META_PAGE_ID=
# long-lived Page access token
META_PAGE_ACCESS_TOKEN=
# Instagram Business account id linked to the Page
META_IG_USER_ID=
META_GRAPH_VERSION=v21.0

# ── LinkedIn (Company Page) ──────────────────────
# token with w_organization_social scope
LINKEDIN_ACCESS_TOKEN=
# numeric organization id, e.g. 12345678
LINKEDIN_ORG_ID=
LINKEDIN_API_VERSION=202510

# ── Optional: Telegram approval notifications ────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
